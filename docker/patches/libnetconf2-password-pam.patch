+/**
+ * @brief PAM conversation for the SSH "password" method: answer the PAM password prompts
+ * with the password the client already sent (no interaction with the client is possible).
+ */
+static int
+nc_pam_passwd_conv_clb(int n_messages, const struct pam_message **msg, struct pam_response **resp, void *appdata_ptr)
+{
+    const char *password = appdata_ptr;
+    int i, j;
+
+    if ((n_messages <= 0) || (n_messages >= PAM_MAX_NUM_MSG)) {
+        return PAM_CONV_ERR;
+    }
+
+    *resp = calloc(n_messages, sizeof **resp);
+    if (!*resp) {
+        return PAM_BUF_ERR;
+    }
+
+    for (i = 0; i < n_messages; i++) {
+        switch (msg[i]->msg_style) {
+        case PAM_PROMPT_ECHO_OFF:
+            (*resp)[i].resp = strdup(password);
+            if (!(*resp)[i].resp) {
+                goto error;
+            }
+            break;
+        case PAM_TEXT_INFO:
+        case PAM_ERROR_MSG:
+            break;
+        default:
+            /* anything else (e.g. a visible prompt) needs keyboard-interactive */
+            goto error;
+        }
+    }
+    return PAM_SUCCESS;
+
+error:
+    for (j = 0; j < n_messages; j++) {
+        free((*resp)[j].resp);
+    }
+    free(*resp);
+    *resp = NULL;
+    return PAM_CONV_ERR;
+}
+
+/**
+ * @brief Handles the SSH "password" method of system users via Linux PAM, using the
+ * same PAM service as keyboard-interactive.
+ *
+ * @param[in] session NETCONF session.
+ * @param[in] username Username of the client to authenticate.
+ * @param[in] password Cleartext password sent by the client.
+ * @return PAM_SUCCESS on success;
+ * @return PAM error otherwise.
+ */
+static int
+nc_server_ssh_auth_password_pam(struct nc_session *session, const char *username, const char *password)
+{
+    pam_handle_t *pam_h = NULL;
+    int ret;
+    struct pam_conv conv;
+
+    conv.conv = nc_pam_passwd_conv_clb;
+    conv.appdata_ptr = (void *)password;
+
+    if (!server_opts.pam_config_name) {
+        ERR(session, "PAM configuration filename not set.");
+        return PAM_ABORT;
+    }
+
+    ret = pam_start(server_opts.pam_config_name, username, &conv, &pam_h);
+    if (ret != PAM_SUCCESS) {
+        ERR(session, "PAM error occurred (%s).", pam_strerror(pam_h, ret));
+        goto cleanup;
+    }
+
+    ret = pam_authenticate(pam_h, 0);
+    if (ret != PAM_SUCCESS) {
+        VRB(session, "PAM error occurred (%s).", pam_strerror(pam_h, ret));
+        goto cleanup;
+    }
+
+    /* an expired token cannot be changed without interaction, so it is a failure here */
+    ret = pam_acct_mgmt(pam_h, 0);
+    if (ret != PAM_SUCCESS) {
+        VRB(session, "PAM error occurred (%s).", pam_strerror(pam_h, ret));
+        goto cleanup;
+    }
+
+cleanup:
+    if (pam_h && (pam_end(pam_h, ret) != PAM_SUCCESS)) {
+        ERR(NULL, "PAM error occurred (%s).", pam_strerror(pam_h, ret));
+    }
+    return ret;
+}
