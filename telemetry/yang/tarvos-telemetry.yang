module tarvos-telemetry {
  yang-version 1.1;
  namespace "urn:tarvos:params:xml:ns:yang:tarvos-telemetry";
  prefix ttel;

  import ietf-yang-types {
    prefix yang;
  }

  organization
    "Tarvos Network OS";
  contact
    "Tarvos project";
  description
    "Kernel counters collected by the Tarvos eBPF telemetry agent
     (tarvos-telemetry), served over gNMI at /tarvos-telemetry:telemetry (or
     /telemetry). Read-only. The counters are those of the eBPF programs
     (telemetry/bpf/tarvos.bpf.c): tc/TCX on every instrumented interface,
     tp_btf/kfree_skb for drops.

     OpenConfig interface counters (/interfaces/interface/state/counters
     in-pkts, in-octets, out-pkts, out-octets) are served from the same
     counters.

     Copyright 2026 Tarvos contributors. Licensed under the Apache License 2.0.";

  revision 2026-11-14 {
    description
      "Initial revision. Tarvos 2.1.1: container (cgroup CPU, memory, PIDs,
       per-daemon resources) and ebpf (map memory, programs).";
  }

  grouping packets-bytes {
    description
      "Packet and byte counters.";
    leaf packets {
      type yang:counter64;
      description
        "Packets.";
    }
    leaf bytes {
      type yang:counter64;
      units "bytes";
      description
        "Bytes.";
    }
  }

  grouping traffic {
    description
      "Traffic of one direction.";
    uses packets-bytes;
    list size-bucket {
      key "le";
      description
        "Packet-size histogram: packets of at most 'le' bytes and more than the
         previous bound (not cumulative).";
      leaf le {
        type string;
        description
          "Upper bound in bytes (64, 128, 256, 512, 1024, 1518, 9216), or
           '+Inf' for the larger packets.";
      }
      leaf packets {
        type yang:counter64;
        description
          "Packets in the bucket.";
      }
    }
  }

  container telemetry {
    config false;
    description
      "eBPF telemetry.";

    container agent {
      description
        "Telemetry agent.";
      leaf version {
        type string;
        description
          "Agent (Tarvos) version.";
      }
      leaf attach {
        type enumeration {
          enum tcx {
            description
              "TCX links (kernel 6.6 and later).";
          }
          enum tc {
            description
              "Legacy clsact qdisc with direct-action filters.";
          }
        }
        description
          "How the tc programs are attached.";
      }
      leaf drop-tracing {
        type boolean;
        description
          "The kfree_skb program is attached (drop counters available).";
      }
    }

    list interface {
      key "name";
      description
        "Interfaces with counters: instrumented ones, and others where the
         kernel dropped packets (VRF masters, excluded interfaces).";
      leaf name {
        type string;
        description
          "Interface name.";
      }
      leaf ifindex {
        type uint32;
        description
          "Interface index.";
      }
      leaf kind {
        type string;
        description
          "Link kind (veth, vxlan, bridge, vrf, ...).";
      }
      leaf instrumented {
        type boolean;
        description
          "The tc programs are attached (rx and tx are available).";
      }
      container rx {
        description
          "Received traffic (tc ingress).";
        uses traffic;
      }
      container tx {
        description
          "Transmitted traffic (tc egress).";
        uses traffic;
      }
      leaf drops {
        type yang:counter64;
        description
          "Packets dropped by the kernel on this interface (all reasons).";
      }
      list drop-reason {
        key "reason";
        description
          "Drops by kernel drop reason.";
        leaf reason {
          type string;
          description
            "Kernel enum skb_drop_reason, lower case without its prefix (for
             example no_socket, netfilter_drop).";
        }
        leaf packets {
          type yang:counter64;
          description
            "Dropped packets.";
        }
      }
    }

    list vni {
      key "id";
      description
        "VXLAN VNIs: counters of their VXLAN device.";
      leaf id {
        type uint32 {
          range "1..16777215";
        }
        description
          "VNI.";
      }
      leaf interface {
        type string;
        description
          "VXLAN device.";
      }
      container rx {
        description
          "Traffic decapsulated from remote VTEPs.";
        uses packets-bytes;
      }
      container tx {
        description
          "Traffic to be encapsulated towards remote VTEPs.";
        uses packets-bytes;
      }
      leaf drops {
        type yang:counter64;
        description
          "Packets dropped on the VXLAN device.";
      }
    }

    list control-plane {
      key "interface protocol direction";
      description
        "Control-plane protocol packets, recognised from their headers.";
      leaf interface {
        type string;
        description
          "Interface.";
      }
      leaf protocol {
        type enumeration {
          enum bgp;
          enum bfd;
          enum ldp;
          enum ospf;
          enum isis;
          enum vrrp;
          enum pim;
          enum lldp;
          enum vxlan {
            description
              "VXLAN-encapsulated packets (outer UDP 4789).";
          }
          enum ssh;
          enum netconf;
          enum tacacs;
          enum gnmi;
          enum prometheus;
        }
        description
          "Protocol.";
      }
      leaf direction {
        type enumeration {
          enum rx;
          enum tx;
        }
        description
          "Direction.";
      }
      uses packets-bytes;
    }

    container container {
      description
        "Resources of this node's container, from its own cgroup (never the
         host's /proc/meminfo or /proc/stat). Same values as the Prometheus
         tarvos_container_* series.";
      leaf cgroup-version {
        type uint8;
        description
          "cgroup version read (2: unified hierarchy, 1: legacy).";
      }
      leaf cpu-seconds {
        type decimal64 {
          fraction-digits 3;
        }
        units "seconds";
        description
          "CPU time used by the container (seconds).";
      }
      leaf memory-usage {
        type uint64;
        units "bytes";
        description
          "Memory charged to the container (memory.current).";
      }
      leaf memory-anon {
        type uint64;
        units "bytes";
        description
          "Anonymous memory (memory.stat anon).";
      }
      leaf memory-file {
        type uint64;
        units "bytes";
        description
          "Page cache (memory.stat file).";
      }
      leaf memory-kernel {
        type uint64;
        units "bytes";
        description
          "Kernel memory (memory.stat kernel, cgroup v2).";
      }
      leaf memory-slab {
        type uint64;
        units "bytes";
        description
          "Slab memory (memory.stat slab, cgroup v2).";
      }
      leaf memory-limit {
        type uint64;
        units "bytes";
        description
          "Memory limit; absent when unlimited.";
      }
      leaf pids {
        type uint64;
        description
          "Processes and threads in the cgroup.";
      }
      leaf uptime {
        type decimal64 {
          fraction-digits 3;
        }
        units "seconds";
        description
          "Time since the container's PID 1 started (seconds).";
      }
      list process {
        key "name";
        description
          "Daemons of the node (all processes of each, summed).";
        leaf name {
          type string;
          description
            "Daemon (bgpd, zebra, netopeer2-server, frr_sync, ...; 'other' for
             the rest).";
        }
        leaf count {
          type uint32;
          description
            "Processes.";
        }
        leaf resident-memory {
          type uint64;
          units "bytes";
          description
            "Resident memory (bytes).";
        }
        leaf cpu-seconds {
          type decimal64 {
            fraction-digits 3;
          }
          units "seconds";
          description
            "CPU time (seconds).";
        }
      }
    }

    container ebpf {
      description
        "Cost of the agent's eBPF objects.";
      leaf attached-interfaces {
        type uint32;
        description
          "Interfaces with the tc programs attached.";
      }
      leaf run-stats {
        type boolean;
        description
          "The host sets kernel.bpf_stats_enabled=1, so per-program run time and
           run count are reported (Tarvos never changes that sysctl).";
      }
      list map {
        key "name";
        description
          "eBPF maps.";
        leaf name {
          type string;
          description
            "Map name.";
        }
        leaf memory {
          type uint64;
          units "bytes";
          description
            "Memory charged for the map (bytes).";
        }
      }
      list program {
        key "name";
        description
          "eBPF programs.";
        leaf name {
          type string;
          description
            "Program name.";
        }
        leaf type {
          type string;
          description
            "Program type (sched_cls, tracing).";
        }
        leaf run-time {
          type uint64;
          units "nanoseconds";
          description
            "Time spent running the program (nanoseconds; only with run-stats).";
        }
        leaf run-count {
          type yang:counter64;
          description
            "Runs of the program (only with run-stats).";
        }
      }
    }
  }
}
