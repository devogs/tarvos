module tarvos-qos {
  yang-version 1.1;
  namespace "urn:tarvos:params:xml:ns:yang:tarvos-qos";
  prefix tqos;

  import ietf-yang-types {
    prefix yang;
  }

  organization
    "Tarvos Network OS";
  contact
    "Tarvos project";
  description
    "Interface quality of service, translated by the backend daemon
     (tarvos-qos-sync) into Linux tc commands (htb, fq_codel, prio, cake).

     Tarvos owns the root qdisc (handle 1:) of every interface listed here and
     rebuilds it when its configuration changes or the interface reappears
     (counters restart from zero). Removing an interface restores the kernel
     default qdisc.

     htb: class 1:1 shapes to 'bandwidth'; each class is htb class 1:<id in
     hex> with an fq_codel leaf; unclassified traffic goes to a default class
     1:fff (priority 7) that gets the bandwidth left over. prio: eight bands; a
     class uses band 'priority + 1', unclassified traffic band 5. DSCP values
     are matched on the IPv4 DS field and the IPv6 traffic class.

     Copyright 2026 Tarvos contributors. Licensed under the Apache License 2.0.";

  revision 2026-11-14 {
    description
      "Backend (tarvos-qos-sync) and operational state: qdisc and class
       statistics.";
  }
  revision 2026-11-12 {
    description
      "Initial revision.";
  }

  typedef dscp {
    type uint8 {
      range "0..63";
    }
    description
      "Differentiated Services Code Point.";
  }

  typedef qdisc-type {
    type enumeration {
      enum htb {
        description
          "Hierarchical token bucket shaping.";
      }
      enum prio {
        description
          "Strict priority queuing.";
      }
      enum fq-codel {
        description
          "Flow queue CoDel, for bufferbloat mitigation.";
      }
      enum cake {
        description
          "Common Applications Kept Enhanced.";
      }
    }
    description
      "Root queueing discipline.";
  }

  grouping counters {
    description
      "Queueing statistics, as reported by tc.";
    leaf packets {
      type yang:counter64;
      description
        "Packets sent.";
    }
    leaf bytes {
      type yang:counter64;
      description
        "Bytes sent.";
    }
    leaf drops {
      type yang:counter64;
      description
        "Packets dropped.";
    }
    leaf overlimits {
      type yang:counter64;
      description
        "Times the rate limit was hit (packets delayed or dropped).";
    }
    leaf requeues {
      type yang:counter64;
      description
        "Packets requeued.";
    }
    leaf backlog-bytes {
      type yang:gauge64;
      description
        "Bytes currently queued.";
    }
    leaf backlog-packets {
      type yang:gauge64;
      description
        "Packets currently queued.";
    }
  }

  container qos {
    description
      "Quality of service configuration.";

    list interface {
      key "name";
      description
        "Per-interface QoS policy.";

      leaf name {
        type string {
          length "1..15";
          pattern '[^/\s]+';
        }
        description
          "Linux interface name (at most 15 characters).";
      }

      leaf qdisc {
        type qdisc-type;
        mandatory true;
        description
          "Root queueing discipline.";
      }

      leaf bandwidth {
        when "../qdisc = 'htb' or ../qdisc = 'cake'" {
          description
            "Only shapers take a bandwidth ceiling.";
        }
        type uint64 {
          range "8..100000000";
        }
        units "kbit/s";
        description
          "Bandwidth ceiling of the interface.";
      }

      list class {
        when "../qdisc = 'htb' or ../qdisc = 'prio'" {
          description
            "Classes exist only below htb and prio.";
        }
        key "id";
        description
          "Traffic class selected by DSCP marking.";

        leaf id {
          type uint16 {
            range "1..4094";
          }
          description
            "Class identifier.";
        }

        leaf-list dscp {
          type dscp;
          description
            "DSCP markings mapped to this class.";
        }

        leaf priority {
          type uint8 {
            range "0..7";
          }
          default "4";
          description
            "Scheduling priority; 0 is the highest.";
        }

        leaf rate {
          type uint64 {
            range "8..100000000";
          }
          units "kbit/s";
          description
            "Guaranteed rate of the class (htb). Unset: an equal share of the
             bandwidth left by the classes that set one.";
        }

        leaf ceil {
          type uint64 {
            range "8..100000000";
          }
          units "kbit/s";
          description
            "Maximum rate of the class (htb); defaults to the interface bandwidth.";
        }

        container state {
          config false;
          description
            "Statistics of the class (htb class, or prio band).";
          uses counters;
        }
      }

      container state {
        config false;
        description
          "Queueing state of the interface.";
        leaf oper-status {
          type enumeration {
            enum present {
              description
                "The interface exists.";
            }
            enum not-present {
              description
                "The interface does not exist (yet).";
            }
          }
          description
            "Whether the interface exists.";
        }
        container root-qdisc {
          description
            "Root queueing discipline currently installed.";
          leaf kind {
            type string;
            description
              "tc qdisc kind (htb, prio, fq_codel, cake, ...).";
          }
          uses counters;
        }
        container default-class {
          description
            "Statistics of the htb default class 1:fff (unclassified traffic).";
          uses counters;
        }
      }
    }
  }
}
