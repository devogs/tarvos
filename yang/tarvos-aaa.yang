module tarvos-aaa {
  yang-version 1.1;
  namespace "urn:tarvos:params:xml:ns:yang:tarvos-aaa";
  prefix taaa;

  import ietf-inet-types {
    prefix inet;
  }
  import ietf-yang-types {
    prefix yang;
  }
  import ietf-netconf-acm {
    prefix nacm;
  }

  organization
    "Tarvos Network OS";
  contact
    "Tarvos project";
  description
    "Runtime AAA overrides for TACACS+ on top of the .env bootstrap defaults.

     Servers configured here replace TACACS_SERVER/TACACS_SECRET (each server
     with its own secret); removing them restores the environment. An unset
     timeout keeps TACACS_TIMEOUT. Changes apply to the next SSH or NETCONF
     login. Disabling the local fallback is refused while no TACACS+ server
     is configured.

     Copyright 2026 Tarvos contributors. Licensed under the Apache License 2.0.";

  revision 2026-11-14 {
    description
      "Backend (tarvos-aaa-sync): runtime servers and local fallback. State:
       effective settings, server reachability, latest authentications.
       Tarvos 2.1.1: authentication counters (authentication-count).";
  }
  revision 2026-11-12 {
    description
      "Initial revision.";
  }

  grouping authentication-event {
    description
      "Outcome of one authentication.";
    leaf result {
      type enumeration {
        enum success;
        enum failure;
      }
      description
        "Outcome.";
    }
    leaf user {
      type string;
      description
        "User name.";
    }
    leaf service {
      type string;
      description
        "PAM service ('sshd' for SSH, 'netopeer2.conf' for NETCONF).";
    }
    leaf remote-host {
      type string;
      description
        "Client address.";
    }
    leaf time {
      type yang:date-and-time;
      description
        "Time of the authentication.";
    }
  }

  container aaa {
    description
      "Authentication, authorization and accounting.";

    container tacacs {
      description
        "TACACS+ client settings.";

      leaf timeout {
        type uint8 {
          range "1..30";
        }
        units "seconds";
        default "3";
        description
          "Time to wait for a server before failing over to the next one (seconds).";
      }

      list server {
        key "address";
        max-elements 4;
        ordered-by user;
        description
          "TACACS+ servers in failover order; the first entry is the primary.";

        leaf address {
          type inet:ip-address;
          description
            "Server IP address.";
        }

        leaf secret {
          nacm:default-deny-all;
          type string {
            length "1..128";
            pattern '[!-~]+';
          }
          mandatory true;
          description
            "Shared secret. Never readable through NETCONF.";
        }
      }
    }

    container local-fallback {
      description
        "Local account used when TACACS+ is unreachable or unconfigured.";

      leaf enabled {
        type boolean;
        default "true";
        description
          "Allow the local admin account to authenticate.";
      }
    }

    container state {
      config false;
      description
        "Operational AAA state.";

      leaf tacacs-active {
        type boolean;
        description
          "True when TACACS+ authentication is currently configured.";
      }

      leaf active-servers {
        type uint8;
        description
          "Number of configured TACACS+ servers.";
      }

      leaf server-source {
        type enumeration {
          enum environment {
            description
              "TACACS_SERVER (no server configured here).";
          }
          enum netconf {
            description
              "/aaa/tacacs/server.";
          }
        }
        description
          "Where the TACACS+ servers in use come from.";
      }

      leaf local-fallback-active {
        type boolean;
        description
          "True when the local admin account may authenticate.";
      }

      leaf active-server {
        type inet:ip-address;
        description
          "First reachable server in failover order: the server that answers
           the next authentication. Absent when none is reachable.";
      }

      list server {
        key "address";
        description
          "TACACS+ servers in use, with their last reachability probe (TCP
           connection to port 49, every AAA_PROBE_INTERVAL seconds).";

        leaf address {
          type inet:ip-address;
          description
            "Server address.";
        }
        leaf priority {
          type uint8;
          description
            "Position in the failover order (1 is the primary).";
        }
        leaf reachable {
          type boolean;
          description
            "The server accepted a TCP connection on the last probe.";
        }
        leaf response-time {
          type uint32;
          units "milliseconds";
          description
            "TCP connection time of the last successful probe (milliseconds).";
        }
        leaf last-probe {
          type yang:date-and-time;
          description
            "Time of the last probe.";
        }
      }

      list authentication-count {
        key "method result";
        description
          "Authentications since the node started, per method and result
           (every PAM outcome recorded by Tarvos: SSH, NETCONF, gNMI).";
        leaf method {
          type enumeration {
            enum tacacs {
              description
                "Checked against TACACS+.";
            }
            enum local {
              description
                "Checked against the local account (admin).";
            }
          }
          description
            "Authentication method.";
        }
        leaf result {
          type enumeration {
            enum success {
              description
                "Accepted.";
            }
            enum failure {
              description
                "Refused.";
            }
          }
          description
            "Outcome.";
        }
        leaf count {
          type yang:counter64;
          description
            "Number of authentications with this method and result.";
        }
      }
      container last-tacacs-authentication {
        description
          "Latest authentication answered by TACACS+.";
        uses authentication-event;
      }

      container last-local-authentication {
        description
          "Latest authentication checked against the local accounts (admin,
           or a user TACACS+ did not accept).";
        uses authentication-event;
      }
    }
  }
}
