module tarvos-frr {
  yang-version 1.1;
  namespace "urn:tarvos:params:xml:ns:yang:tarvos-frr";
  prefix tfrr;

  import ietf-inet-types {
    prefix inet;
  }
  import ietf-yang-types {
    prefix yang;
  }
  import tarvos-types {
    prefix ttypes;
  }

  organization
    "Tarvos Network OS";
  contact
    "Tarvos project";
  description
    "FRR configuration blocks for the daemons that have neither an mgmtd backend
     nor a structured Tarvos model in this release: pimd, pim6d, ldpd, nhrpd,
     eigrpd, babeld, pbrd, vrrpd and fabricd.

     Each daemon carries FRR CLI lines, grouped in top-level blocks and
     interface blocks. They are validated by vtysh and applied with frr-reload
     in the same transaction as the other Tarvos routing modules. Once a daemon
     is configured here, Tarvos owns the blocks listed here (removing one from
     the list removes it from FRR) and every interface line of that daemon (for
     example ' ip pim'): interface lines of that daemon not listed here are
     removed. Other blocks of the daemon (CLI-made, or created by the daemon
     itself) are left alone.

     Prefer the structured modules where they exist: FRR native YANG through
     mgmtd (frr-interface, frr-vrf, frr-zebra, frr-staticd, frr-ripd,
     frr-ripngd), FRR native YANG through vtysh (frr-filter, frr-route-map,
     frr-bgp-route-map, frr-bfdd), and tarvos-bgp, tarvos-ospf, tarvos-isis.

     /frr/state reports the sessions of these daemons (and of bfdd) as far as
     vtysh exposes them, read on every request with 'show ... json'. A
     subtree is empty while its daemon is not running.

     Copyright 2026 Tarvos contributors. Licensed under the Apache License 2.0.";

  revision 2026-11-14 {
    description
      "Operational state: PIM neighbours, LDP sessions, VRRP routers, BFD
       peers.";
  }
  revision 2026-11-13 {
    description
      "Initial revision.";
  }

  typedef config-line {
    type string {
      length "1..255";
      pattern '[ -~]+';
      pattern '.*[!#].*' {
        modifier invert-match;
        error-message "'!' and '#' start comments and are not allowed";
      }
    }
    description
      "One FRR configuration line (printable ASCII). Leading spaces express
       nesting below the block (for example '  address-family ipv4').";
  }

  container frr {
    description
      "FRR daemons configured with CLI lines.";

    list daemon {
      key "name";
      description
        "Daemon configuration. The daemon must be listed in FRR_DAEMONS.";
      leaf name {
        type enumeration {
          enum pimd {
            description
              "PIM (IPv4): 'router pim' blocks; ' ip pim', ' ip igmp',
               ' ip mroute' interface lines.";
          }
          enum pim6d {
            description
              "PIM (IPv6): 'router pim6' blocks; ' ipv6 pim', ' ipv6 mld',
               ' ipv6 mroute' interface lines.";
          }
          enum ldpd {
            description
              "LDP: 'mpls ldp' and 'l2vpn' blocks.";
          }
          enum nhrpd {
            description
              "NHRP: ' ip nhrp', ' ipv6 nhrp' interface lines.";
          }
          enum eigrpd {
            description
              "EIGRP: 'router eigrp' blocks; interface lines ending with
               'eigrp' (for example ' ip hello-interval eigrp 5').";
          }
          enum babeld {
            description
              "Babel: 'router babel' blocks; ' babel' interface lines.";
          }
          enum pbrd {
            description
              "Policy-based routing: 'pbr-map' blocks; ' pbr-policy' interface
               lines.";
          }
          enum vrrpd {
            description
              "VRRP: ' vrrp' interface lines.";
          }
          enum fabricd {
            description
              "OpenFabric: 'router openfabric' blocks; ' ip router openfabric',
               ' ipv6 router openfabric', ' openfabric' interface lines.";
          }
        }
        description
          "FRR daemon.";
      }

      list block {
        key "header";
        ordered-by user;
        description
          "Top-level configuration blocks.";
        leaf header {
          type config-line {
            pattern '[^ ].*';
          }
          description
            "Block header, for example 'router eigrp 10' or 'mpls ldp'. It must
             be one of the daemon's block types (see the daemon name).";
        }
        leaf-list line {
          type config-line;
          ordered-by user;
          description
            "Lines of the block, without the closing 'exit'.";
        }
      }

      list interface {
        key "name";
        description
          "Interface lines of this daemon.";
        leaf name {
          type ttypes:interface-name;
          description
            "Interface.";
        }
        leaf-list line {
          type config-line {
            pattern '[^ ].*';
          }
          min-elements 1;
          ordered-by user;
          description
            "Interface lines, without indentation, for example 'ip pim' or
             'vrrp 5 ip 10.0.0.1'. Each must be one of the daemon's interface
             line types.";
        }
      }
    }

    container state {
      config false;
      description
        "Operational state of the daemons, read from FRR on request.";

      container pim {
        description
          "pimd (IPv4 PIM).";
        list neighbor {
          key "interface address";
          description
            "PIM neighbours ('show ip pim neighbor').";
          leaf interface {
            type ttypes:interface-name;
            description
              "Local interface.";
          }
          leaf address {
            type inet:ip-address-no-zone;
            description
              "Neighbour address.";
          }
          leaf uptime {
            type uint32;
            units "seconds";
            description
              "Time since the neighbour was discovered.";
          }
          leaf holdtime-remaining {
            type uint32;
            units "seconds";
            description
              "Time left before the neighbour expires.";
          }
          leaf dr-priority {
            type uint32;
            description
              "Designated router priority advertised by the neighbour.";
          }
        }
      }

      container ldp {
        description
          "ldpd.";
        list neighbor {
          key "lsr-id";
          description
            "LDP sessions ('show mpls ldp neighbor').";
          leaf lsr-id {
            type inet:ipv4-address-no-zone;
            description
              "LSR ID of the neighbour.";
          }
          leaf address-family {
            type enumeration {
              enum ipv4;
              enum ipv6;
            }
            description
              "Address family of the session transport.";
          }
          leaf transport-address {
            type inet:ip-address-no-zone;
            description
              "Transport address of the neighbour.";
          }
          leaf state {
            type string;
            description
              "Session state as reported by ldpd ('operational' once the
               session is up; 'initialized', 'opensent', 'openrec', ...
               before).";
          }
          leaf uptime {
            type uint32;
            units "seconds";
            description
              "Time since the session reached its state.";
          }
        }
      }

      container vrrp {
        description
          "vrrpd.";
        list router {
          key "interface vrid";
          description
            "VRRP virtual routers ('show vrrp').";
          leaf interface {
            type ttypes:interface-name;
            description
              "Interface of the virtual router.";
          }
          leaf vrid {
            type uint8 {
              range "1..255";
            }
            description
              "Virtual router ID.";
          }
          leaf version {
            type uint8;
            description
              "VRRP version.";
          }
          leaf priority {
            type uint8;
            description
              "Configured priority.";
          }
          list address-family {
            key "name";
            description
              "Per address family instance.";
            leaf name {
              type enumeration {
                enum ipv4;
                enum ipv6;
              }
              description
                "Address family.";
            }
            leaf state {
              type enumeration {
                enum initialize {
                  description
                    "Not running (for example: no macvlan device for the
                     virtual MAC yet).";
                }
                enum backup;
                enum master;
              }
              description
                "VRRP state.";
            }
            leaf effective-priority {
              type uint8;
              description
                "Priority in use (255 when the router owns the address).";
            }
            leaf macvlan-interface {
              type ttypes:interface-name;
              description
                "macvlan device carrying the virtual MAC.";
            }
            leaf master-address {
              type inet:ip-address-no-zone;
              description
                "Primary address of the current master (this router's
                 own address while it is master).";
            }
            leaf-list virtual-address {
              type inet:ip-address-no-zone;
              description
                "Virtual addresses.";
            }
            leaf advertisements-sent {
              type yang:counter64;
              description
                "Advertisements sent.";
            }
            leaf advertisements-received {
              type yang:counter64;
              description
                "Advertisements received.";
            }
            leaf transitions {
              type yang:counter32;
              description
                "State transitions.";
            }
          }
        }
      }

      container bfd {
        description
          "bfdd.";
        list peer {
          key "local-discriminator";
          description
            "BFD sessions ('show bfd peers').";
          leaf local-discriminator {
            type uint32;
            description
              "Local discriminator of the session.";
          }
          leaf remote-discriminator {
            type uint32;
            description
              "Discriminator chosen by the peer.";
          }
          leaf peer-address {
            type inet:ip-address-no-zone;
            description
              "Peer address.";
          }
          leaf local-address {
            type inet:ip-address-no-zone;
            description
              "Local address, when configured.";
          }
          leaf interface {
            type ttypes:interface-name;
            description
              "Interface, when configured.";
          }
          leaf vrf {
            type ttypes:vrf-name;
            description
              "VRF of the session.";
          }
          leaf multihop {
            type boolean;
            description
              "Multihop session.";
          }
          leaf status {
            type enumeration {
              enum up;
              enum down;
              enum init;
              enum shutdown {
                description
                  "Administratively down.";
              }
            }
            description
              "Session state.";
          }
          leaf uptime {
            type uint32;
            units "seconds";
            description
              "Time since the session came up.";
          }
          leaf downtime {
            type uint32;
            units "seconds";
            description
              "Time since the session went down.";
          }
          leaf diagnostic {
            type string;
            description
              "Local diagnostic of the last state change.";
          }
          leaf remote-diagnostic {
            type string;
            description
              "Diagnostic reported by the peer.";
          }
          leaf receive-interval {
            type uint32;
            units "milliseconds";
            description
              "Configured minimum receive interval.";
          }
          leaf transmit-interval {
            type uint32;
            units "milliseconds";
            description
              "Configured minimum transmit interval.";
          }
          leaf detect-multiplier {
            type uint8;
            description
              "Configured detection multiplier.";
          }
        }
      }
    }
  }
}
