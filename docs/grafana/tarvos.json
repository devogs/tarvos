      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance, reason) (rate(tarvos_interface_drops_total{instance=~\"$node\"}[5m]))",
