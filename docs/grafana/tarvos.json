          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "tarvos_interface_up{instance=~\"$node\",kind!=\"vrf\"} == 0",
          "legendFormat": "{{instance}} {{interface}}"
        }
