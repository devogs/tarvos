# Copy to .env and adjust. Never commit .env.

# --- AAA / TACACS+ ---------------------------------------------------------
# List of TACACS+ servers, primary first. Accepted formats:
#   ["10.0.0.10", "10.0.0.11"]   [10.0.0.10, 10.0.0.11]   10.0.0.10,10.0.0.11
# Unset or empty => local-only authentication (admin account).
TACACS_SERVER=["<primary_ip>", "<secondary_ip>"]
TACACS_SECRET=<shared_secret>
# Seconds to wait for a TACACS+ server before failing over (integer).
TACACS_TIMEOUT=3
# NETCONF rights of TACACS+ users: ro (default), rw or none
TACACS_NETCONF_ACCESS=ro
# Seconds between TCP reachability probes of the TACACS+ servers (tarvos-aaa state)
AAA_PROBE_INTERVAL=30

# Local fallback account. Defaults to "admin"; override for anything beyond a lab.
ADMIN_PASSWORD=admin

# --- Management VRF --------------------------------------------------------
# The management interface is placed in a dedicated VRF at boot.
MGMT_VRF_ENABLED=yes
MGMT_VRF_NAME=mgmt
MGMT_VRF_TABLE=1001
MGMT_INTERFACE=eth0

# --- SSH -------------------------------------------------------------------
SSH_PORT=22
SSH_PERMIT_ROOT_LOGIN=no
SSH_PASSWORD_AUTH=yes

# --- NETCONF (netopeer2) ---------------------------------------------------
NETCONF_PORT=830
# Timeout (seconds) of every Sysrepo call made for a NETCONF request, including the
# backends applying a change (large edits: hundreds of VNIs or prefix-list entries).
#NETCONF_TIMEOUT=120

# --- Syslog ----------------------------------------------------------------
# All logs go to stdout. Optionally also forward them to remote collectors
# (list syntax as TACACS_SERVER, at most 4). Unset => stdout only.
SYSLOG_SERVER=["<collector_ip>"]
SYSLOG_PORT=514
SYSLOG_PROTOCOL=udp
# emerg|alert|crit|err|warning|notice|info|debug
SYSLOG_MIN_SEVERITY=info

# --- EVPN hosts -------------------------------------------------------------
# Keep the local hosts of the L2 VNIs known: probe every STALE neighbor (unicast ARP/ND from the gateway)
NEIGH_REFRESH_ENABLED=yes

# --- LLDP (lldpd) ----------------------------------------------------------
# Neighbour discovery on all interfaces. Inspect with: lldpcli show neighbors
LLDP_ENABLED=yes
# lldpd interface pattern: comma separated names/wildcards, "!" excludes (e.g. eth*,!eth0)
LLDP_INTERFACES=*
# Seconds between advertisements, and multiplier for the neighbour's holdtime
LLDP_TX_INTERVAL=30
LLDP_TX_HOLD=4
# Optional; default to the container hostname and "Tarvos Network OS"
#LLDP_SYSTEM_NAME=
#LLDP_SYSTEM_DESCRIPTION=

# --- FRR (10.7.1) ------------------------------------------------------------
# FRR daemons to run: space or comma separated, e.g. "bgpd" or "[bgpd, bfdd, ospfd]".
# mgmtd, zebra and staticd always run. NETCONF configuration of a daemon that is not
# listed is refused (for BGP EVPN: bgpd; add bfdd for BFD, ospfd/isisd for an IGP).
FRR_DAEMONS=

# --- QoS (tarvos-qos) --------------------------------------------------------
# Seconds between checks for configured interfaces that appeared or were recreated
QOS_REAPPLY_INTERVAL=10

# --- eBPF telemetry ------------------------------------------------------------
# Kernel counters per interface (rx/tx packets, bytes, size histogram, drops by reason),
# per VNI and per control-plane protocol. Needs CAP_BPF and CAP_PERFMON (drop tracing)
# and a kernel with BTF (/sys/kernel/btf/vmlinux). Inspect: tarvos-telemetry snapshot
TELEMETRY_ENABLED=yes
# Interface name globs never instrumented (space or comma separated)
TELEMETRY_EXCLUDE=lo
# Seconds between checks for new interfaces
TELEMETRY_SYNC_INTERVAL=5
# VRF the Prometheus and gNMI endpoints listen in. Unset: the management VRF (when
# MGMT_VRF_ENABLED=yes); "none": every VRF.
#TELEMETRY_LISTEN_VRF=

# --- Prometheus exporter (part of the telemetry agent) -------------------------
PROMETHEUS_ENABLED=yes
PROMETHEUS_PORT=9273
# Series beyond the eBPF counters (see the README "Prometheus" table):
# routing state (BGP, EVPN, PIM/LDP/VRRP/BFD) and kernel/node metrics (container CPU and
# memory, per-daemon resources, eBPF cost, interface gauges, QoS/CoPP/AAA/LLDP).
# "no" on both keeps the eBPF-only footprint of 2.1.0.
PROMETHEUS_ROUTING_METRICS=yes
PROMETHEUS_KERNEL_METRICS=yes
# Seconds the routing/kernel state read for a scrape is reused (1-3600).
PROMETHEUS_STATE_CACHE=10

# --- gNMI server (part of the telemetry agent) ---------------------------------
# Capabilities, Get, Subscribe (ONCE, POLL, STREAM: SAMPLE / ON_CHANGE); read-only.
# Users authenticate like over NETCONF (admin, TACACS+; TACACS_NETCONF_ACCESS=none
# also denies gNMI to TACACS+ users).
GNMI_ENABLED=yes
GNMI_PORT=57400
# TLS with the mounted certificate, or a self-signed one generated at boot and
# written to /run/tarvos/gnmi/server.crt. GNMI_TLS=no: plaintext (labs only).
GNMI_TLS=yes
#GNMI_TLS_CERT=/etc/tarvos/gnmi/server.crt
#GNMI_TLS_KEY=/etc/tarvos/gnmi/server.key

# --- Daemon runtime --------------------------------------------------------
LOG_LEVEL=info

# Supervision: every daemon that exits is restarted (1 s more delay per recent restart,
# at most 10 s). A critical daemon (sshd, sysrepo-plugind, netopeer2-server, frr_sync,
# netdev_sync, kernel_sync) restarted more than CRASH_LOOP_MAX times within
# CRASH_LOOP_WINDOW seconds stops the container instead, for the orchestrator to restart.
#CRASH_LOOP_MAX=5
#CRASH_LOOP_WINDOW=120
YANG_DIR=/opt/tarvos/yangs
# Space-separated list of Python backend daemons to start from /opt/tarvos/daemons
TARVOS_DAEMONS=
