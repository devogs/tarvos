# Copy to .env and adjust. Never commit .env.

# --- AAA / TACACS+ ---------------------------------------------------------
# List of TACACS+ servers, primary first. Accepted formats:
#   ["10.0.0.10", "10.0.0.11"]   [10.0.0.10, 10.0.0.11]   10.0.0.10,10.0.0.11
# Unset or empty => local-only authentication (admin account).
TACACS_SERVER=["<primary_ip>", "<secondary_ip>"]
TACACS_SECRET=<shared_secret>
# Seconds to wait for a TACACS+ server before failing over (integer).
TACACS_TIMEOUT=3

# Local fallback account. Defaults to "admin"; override for anything beyond a lab.
ADMIN_PASSWORD=admin

# --- Management VRF --------------------------------------------------------
# The management interface is placed in a dedicated VRF at boot.
MGMT_VRF_ENABLED=yes
MGMT_VRF_NAME=mgmt
MGMT_VRF_TABLE=1001
MGMT_INTERFACE=eth0

# --- SSH -------------------------------------------------------------------
SSH_PORT=22
SSH_PERMIT_ROOT_LOGIN=no
SSH_PASSWORD_AUTH=yes

# --- NETCONF (netopeer2) ---------------------------------------------------
NETCONF_PORT=830

# --- Syslog ----------------------------------------------------------------
# All logs go to stdout. Optionally also forward them to remote collectors
# (list syntax as TACACS_SERVER, at most 4). Unset => stdout only.
SYSLOG_SERVER=["<collector_ip>"]
SYSLOG_PORT=514
SYSLOG_PROTOCOL=udp
# emerg|alert|crit|err|warning|notice|info|debug
SYSLOG_MIN_SEVERITY=info

# --- Daemon runtime --------------------------------------------------------
LOG_LEVEL=info
YANG_DIR=/opt/tarvos/yangs
# Space-separated list of Python backend daemons to start from /opt/tarvos/daemons
TARVOS_DAEMONS=
