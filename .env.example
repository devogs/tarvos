# Copy to .env and adjust. Never commit .env.

# --- AAA / TACACS+ ---------------------------------------------------------
# List of TACACS+ servers, primary first. Accepted formats:
#   ["10.0.0.10", "10.0.0.11"]   [10.0.0.10, 10.0.0.11]   10.0.0.10,10.0.0.11
# Unset or empty => local-only authentication (admin account).
TACACS_SERVER=["<primary_ip>", "<secondary_ip>"]
TACACS_SECRET=<shared_secret>
# Seconds to wait for a TACACS+ server before failing over (integer).
TACACS_TIMEOUT=3
# NETCONF rights of TACACS+ users: ro (default), rw or none
TACACS_NETCONF_ACCESS=ro

# Local fallback account. Defaults to "admin"; override for anything beyond a lab.
ADMIN_PASSWORD=admin

# --- Management VRF --------------------------------------------------------
# The management interface is placed in a dedicated VRF at boot.
MGMT_VRF_ENABLED=yes
MGMT_VRF_NAME=mgmt
MGMT_VRF_TABLE=1001
MGMT_INTERFACE=eth0

# --- SSH -------------------------------------------------------------------
SSH_PORT=22
SSH_PERMIT_ROOT_LOGIN=no
SSH_PASSWORD_AUTH=yes

# --- NETCONF (netopeer2) ---------------------------------------------------
NETCONF_PORT=830

# --- Syslog ----------------------------------------------------------------
# All logs go to stdout. Optionally also forward them to remote collectors
# (list syntax as TACACS_SERVER, at most 4). Unset => stdout only.
SYSLOG_SERVER=["<collector_ip>"]
SYSLOG_PORT=514
SYSLOG_PROTOCOL=udp
# emerg|alert|crit|err|warning|notice|info|debug
SYSLOG_MIN_SEVERITY=info

# --- LLDP (lldpd) ----------------------------------------------------------
# Neighbour discovery on all interfaces. Inspect with: lldpcli show neighbors
LLDP_ENABLED=yes
# lldpd interface pattern: comma separated names/wildcards, "!" excludes (e.g. eth*,!eth0)
LLDP_INTERFACES=*
# Seconds between advertisements, and multiplier for the neighbour's holdtime
LLDP_TX_INTERVAL=30
LLDP_TX_HOLD=4
# Optional; default to the container hostname and "Tarvos Network OS"
#LLDP_SYSTEM_NAME=
#LLDP_SYSTEM_DESCRIPTION=

# --- FRR (10.7.1) ------------------------------------------------------------
# FRR daemons to run: space or comma separated, e.g. "bgpd" or "[bgpd, bfdd, ospfd]".
# mgmtd, zebra and staticd always run. NETCONF configuration of a daemon that is not
# listed is refused (for BGP EVPN: bgpd; add bfdd for BFD, ospfd/isisd for an IGP).
FRR_DAEMONS=

# --- Daemon runtime --------------------------------------------------------
LOG_LEVEL=info
YANG_DIR=/opt/tarvos/yangs
# Space-separated list of Python backend daemons to start from /opt/tarvos/daemons
TARVOS_DAEMONS=
